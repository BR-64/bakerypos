// Cloudflare Worker that only serves the built PWA (no Worker code, no server).
// Deploy: npm run build, then npx wrangler deploy.
// All data stays on each phone, tied to this site's address — pick the final
// domain before staff use it; a new address starts with an empty database.
{
  "name": "bakery-pos",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
